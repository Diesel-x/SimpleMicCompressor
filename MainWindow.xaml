<Window x:Class="MicCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MicCompressor.ViewModels"
        mc:Ignorable="d"
        Title="MicCompressor — Компрессор звука микрофона для Discord и Игр"
        Height="860" Width="1120"
        MinHeight="780" MinWidth="1020"
        WindowStartupLocation="CenterScreen"
        Background="#131417"
        Foreground="#ffffff"
        FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <!-- Colors -->
        <SolidColorBrush x:Key="BgDark" Color="#131417"/>
        <SolidColorBrush x:Key="BgCard" Color="#1e2026"/>
        <SolidColorBrush x:Key="BgInput" Color="#282a33"/>
        <SolidColorBrush x:Key="BorderCard" Color="#353742"/>
        <SolidColorBrush x:Key="Accent" Color="#5865f2"/>
        <SolidColorBrush x:Key="GreenActive" Color="#57f287"/>
        <SolidColorBrush x:Key="RedDanger" Color="#ed4245"/>
        <SolidColorBrush x:Key="AmberMeter" Color="#fee75c"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#e2e4e9"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9da4b0"/>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="#484b56" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBox Style with Crystal-Clear Contrast -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="#282a33" BorderBrush="#404350" BorderThickness="1.5" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#ffffff" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Data="M 0 0 L 5 5 L 10 0 Z" StrokeThickness="1" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5865f2" />
                    <Setter TargetName="Border" Property="Background" Value="#31333e" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5865f2" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#24262e"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter TextBlock.Foreground="#ffffff" 
                                              TextBlock.FontSize="13" 
                                              TextBlock.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3a3d4a"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5865f2"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#282a33"/>
            <Setter Property="BorderBrush" Value="#404350"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="false" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              TextBlock.Foreground="#ffffff"
                                              TextBlock.FontSize="13"
                                              TextBlock.FontWeight="SemiBold"
                                              Margin="12,0,32,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="true" Focusable="false" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="true" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                                    <Border x:Name="DropDownBorder" Background="#24262e" 
                                            BorderBrush="#484c5a" BorderThickness="1.5" CornerRadius="8" Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.5"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="true" Margin="4">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Slider -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#5865f2" Height="6" CornerRadius="3,0,0,3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#353742" Height="6" CornerRadius="0,3,3,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="20" Height="20" Fill="#ffffff" Stroke="#5865f2" StrokeThickness="3">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox with High Contrast -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1e2026"/>
            <Setter Property="BorderBrush" Value="#353742"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 1. Header -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Devices & VU Meters -->
            <RowDefinition Height="Auto"/>
            <!-- 3. DSP Controls -->
            <RowDefinition Height="*"/>
            <!-- 4. Footer Tip -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Status Indicator -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#5865f2" Width="44" Height="44" CornerRadius="12" Margin="0,0,14,0">
                    <TextBlock Text="🎙️" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="MicCompressor" FontSize="21" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        <Border Background="#282a33" BorderBrush="#3f4250" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Low-Latency DSP • Background" FontSize="11.5" FontWeight="SemiBold" Foreground="#d1d5db"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Ellipse Width="10" Height="10" Fill="{Binding EngineStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EngineStatusText}" FontSize="13" Foreground="{Binding EngineStatusColor}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Top Controls (Preset, Custom Profiles, Bypass, Power, Minimize) -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Preset Dropdown with Delete button -->
                <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="Пресет / Профиль:" FontSize="12" FontWeight="SemiBold" Foreground="#e2e4e9" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="180" Height="36" 
                                  ItemsSource="{Binding Presets}" 
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>
                        <Button Content="🗑️" Command="{Binding DeleteProfileCommand}" 
                                IsEnabled="{Binding IsCustomProfileSelected}"
                                Width="34" Height="36" Margin="4,0,0,0"
                                ToolTip="Удалить выбранный кастомный профиль"
                                Background="#2e303c" Foreground="#ed4245" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Save Profile Field -->
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="Имя нового профиля:" FontSize="12" FontWeight="SemiBold" Foreground="#e2e4e9" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="125" Height="36" 
                                 Text="{Binding ProfileNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#282a33" Foreground="#ffffff" BorderBrush="#404350" BorderThickness="1.5"
                                 Padding="8,6" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="💾 Сохранить" Command="{Binding SaveProfileCommand}"
                                Height="36" Padding="10,0" Margin="4,0,0,0"
                                Background="#3a3d4c" Foreground="#ffffff" FontWeight="Bold" FontSize="11.5" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Bypass Toggle -->
                <CheckBox Content="Bypass" 
                          IsChecked="{Binding BypassAll, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,14,14,0"
                          ToolTip="Отключает всю обработку, пропуская чистый исходный звук"/>

                <!-- Minimize to Tray Button -->
                <Button Content="В трей" 
                        Click="OnMinimizeToTrayClicked"
                        Width="85" Height="38" 
                        Margin="0,10,10,0"
                        FontSize="12" FontWeight="Bold" Cursor="Hand"
                        Foreground="#ffffff" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#32353f"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="10,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#404350"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Start / Stop Power Button -->
                <Button Content="{Binding StartStopButtonText}" 
                        Command="{Binding ToggleEngineCommand}"
                        Width="125" Height="38" 
                        Margin="0,10,0,0"
                        FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Foreground="#ffffff" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#5865f2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,6">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="true">
                                    <Setter Property="Background" Value="#ed4245"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. ROUTING & LIVE VU METERS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card: Audio Devices & Routing -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="🎧 Аудиоустройства и маршрутизация" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                        <Button Content="🔄 Обновить" Command="{Binding RefreshDevicesCommand}" 
                                HorizontalAlignment="Right" Background="Transparent" Foreground="#5865f2" 
                                BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="Bold" Padding="4,0"/>
                    </Grid>

                    <!-- Mic Input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Вход (Ваш физический микрофон):" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding InputDevices}" 
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="36"/>
                    </StackPanel>

                    <!-- Output (Cable or Speakers) -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="Выход (Виртуальный кабель для Discord/Игр):" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding OutputDevices}" 
                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="36"/>
                    </StackPanel>

                    <!-- Virtual Cable Helper (Auto-Install & Reinstall) -->
                    <Border Grid.Row="3" Background="#282a33" BorderBrush="#3f4250" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="⚠️ Виртуальный кабель не установлен. Установите в 1 клик для Discord:"/>
                                            <Setter Property="Foreground" Value="#fee75c"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                    <Setter Property="Text" Value="✅ Виртуальный кабель активен. В Discord выберите CABLE Output."/>
                                                    <Setter Property="Foreground" Value="#57f287"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Cursor="Hand" FontSize="12" FontWeight="Bold" Padding="12,6" Foreground="#ffffff" BorderThickness="0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#5865f2"/>
                                                <Setter Property="Content" Value="⚡ Установить кабель (1 клик)"/>
                                                <Setter Property="Command" Value="{Binding InstallVbCableCommand}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                        <Setter Property="Background" Value="#3a3d4a"/>
                                                        <Setter Property="Content" Value="🔄 Переустановить кабель"/>
                                                        <Setter Property="Command" Value="{Binding ReinstallVbCableCommand}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Content" Value="Выполняется..."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Live Installer Status Banner -->
                            <TextBlock Text="{Binding InstallerStatus}" 
                                       FontSize="11.5" FontWeight="SemiBold" Foreground="#fee75c" 
                                       Margin="0,6,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                            <Trigger Property="Text" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Headphone Monitor -->
                    <Border Grid.Row="4" Background="#23252d" BorderBrush="#353742" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" Content="Самопрослушивание" 
                                      IsChecked="{Binding MonitorEnabled, Mode=TwoWay}" 
                                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MonitorDevices}" 
                                      SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                      DisplayMemberPath="Name" Height="32" FontSize="12"
                                      IsEnabled="{Binding MonitorEnabled}" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Slider Minimum="0.0" Maximum="1.0" Value="{Binding MonitorVolume, Mode=TwoWay}" 
                                        IsEnabled="{Binding MonitorEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Card: Live VU Meters -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="📊 Индикаторы уровней (VU Meters)" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                        <Border HorizontalAlignment="Right" Background="#282a33" BorderBrush="#3f4250" BorderThickness="1" CornerRadius="6" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Гейт: " FontSize="12" FontWeight="SemiBold" Foreground="#e2e4e9"/>
                                <TextBlock Text="{Binding GateStatusText}" FontSize="12" FontWeight="Bold" Foreground="{Binding GateStatusColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Input Level Meter -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Вход (Микрофон)" FontSize="12.5" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding InputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#57f287"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#282a33" Height="14" CornerRadius="7">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding InputMeterPercent, Mode=OneWay}" 
                                         Height="14" Foreground="#57f287" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- Gain Reduction Meter (Amber) -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Сжатие компрессора (Gain Reduction)" FontSize="12.5" FontWeight="SemiBold" Foreground="#fee75c"/>
                            <TextBlock Text="{Binding GainReductionDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#fee75c"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#282a33" Height="14" CornerRadius="7">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GainReductionMeterPercent, Mode=OneWay}" 
                                         Height="14" Foreground="#fee75c" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- Output Level Meter -->
                    <Grid Grid.Row="3" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Выход в Discord/Игры" FontSize="12.5" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding OutputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#5865f2"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#282a33" Height="14" CornerRadius="7">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding OutputMeterPercent, Mode=OneWay}" 
                                         Height="14" Foreground="#5865f2" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. DSP CONTROLS CARDS -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- CARD 1: NOISE GATE -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🔇 Шумоподавитель" FontSize="15" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding GateEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Отсекает клики мыши, клавиатуру, дыхание и шум кулеров между фразами." 
                               FontSize="12" Foreground="#e2e4e9" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <!-- Threshold -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Порог (Threshold)" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding GateThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#5865f2"/>
                        </Grid>
                        <Slider Minimum="-60" Maximum="-20" Value="{Binding GateThresholdDb, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"/>
                        <TextBlock Text="Ниже этого порога фоновый шум глушится" FontSize="11.5" Foreground="#9da4b0" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Release -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Затухание (Release)" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding GateReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#5865f2"/>
                        </Grid>
                        <Slider Minimum="20" Maximum="400" Value="{Binding GateReleaseMs, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"/>
                        <TextBlock Text="Плавность закрытия (сохраняет окончания слов)" FontSize="11.5" Foreground="#9da4b0" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CARD 2: DYNAMIC COMPRESSOR -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="🎚️ Компрессор динамики" FontSize="15" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Выравнивает громкость: шепот звучит разборчиво, а громкая речь сдерживается на одном комфортном уровне." 
                               FontSize="12" Foreground="#e2e4e9" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <!-- Threshold -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Порог сжатия (Threshold)" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding CompressorThresholdDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#5865f2"/>
                        </Grid>
                        <Slider Minimum="-40" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                    </StackPanel>

                    <!-- Ratio -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Степень сжатия (Ratio)" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding CompressorRatio, StringFormat={}{0:F1}:1}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#5865f2"/>
                        </Grid>
                        <Slider Minimum="1.5" Maximum="10.0" Value="{Binding CompressorRatio, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                    </StackPanel>

                    <!-- Makeup Gain -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,3">
                            <TextBlock Text="Усиление громкости (Makeup Gain)" FontSize="13" FontWeight="SemiBold" Foreground="#ffffff"/>
                            <TextBlock Text="{Binding CompressorMakeupGainDb, StringFormat=+{0:F1} dB}" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#57f287"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="18" Value="{Binding CompressorMakeupGainDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                    </StackPanel>

                    <!-- Attack & Release -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Атака" FontSize="12.5" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="{Binding CompressorAttackMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#d1d5db"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="40" Value="{Binding CompressorAttackMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Спад" FontSize="12.5" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="{Binding CompressorReleaseMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#d1d5db"/>
                            </Grid>
                            <Slider Minimum="30" Maximum="400" Value="{Binding CompressorReleaseMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- CARD 3: PROTECTION & BACKGROUND OPTIONS -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="🛡️ Защита звука" FontSize="15" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,12"/>

                    <!-- High-pass Filter -->
                    <Border Background="#24262e" BorderBrush="#3a3d4a" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Срез гула (Low-Cut 80 Hz)" FontWeight="Bold" FontSize="13" Foreground="#ffffff"/>
                                <CheckBox IsChecked="{Binding HighPassEnabled, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Удаляет вибрации стола, гул кулеров и хлопки дыхания." 
                                       FontSize="11.5" Foreground="#e2e4e9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Limiter -->
                    <Border Background="#24262e" BorderBrush="#3a3d4a" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Лимитер (Пик-блокер)" FontWeight="Bold" FontSize="13" Foreground="#ffffff"/>
                                <CheckBox IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Мягко срезает резкие эмоциональные крики без хрипа." 
                                       FontSize="11.5" Foreground="#e2e4e9" TextWrapping="Wrap" Margin="0,0,0,3"/>
                            <Grid>
                                <TextBlock Text="Потолок:" FontSize="12" FontWeight="SemiBold" Foreground="#e2e4e9"/>
                                <TextBlock Text="{Binding LimiterCeilingDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12.5" FontWeight="Bold" Foreground="#5865f2"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Meme Mode (Destroyed Mic Joke) -->
                    <Border Background="#272124" BorderBrush="#4a3038" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="🎙️ Уничтоженный микро (Meme)" FontWeight="Bold" FontSize="13" Foreground="#ff7b72"/>
                                <CheckBox IsChecked="{Binding DestroyedMicMemeMode, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Тот самый прикольный разрушенный звук для троллинга в Discord." 
                                       FontSize="11.5" Foreground="#e3b341" TextWrapping="Wrap" Margin="0,0,0,6"/>

                            <!-- Important Discord Krisp Tip -->
                            <Border Background="#352418" BorderBrush="#6e461b" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Важно для Discord:" FontWeight="Bold" FontSize="11" Foreground="#fee75c"/>
                                    <TextBlock Text="Обязательно отключите шумоподавление Krisp в Discord (Настройки -> Голос и видео -> Шумоподавление: Откл), иначе Discord заглушит мемный перегруз как шум!" 
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="#ffd166" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Background / Tray Options -->
                    <TextBlock Text="⚙️ Фоновый режим" FontSize="13" FontWeight="Bold" Foreground="#ffffff" Margin="0,2,0,10"/>
                    <CheckBox Content="Автозапуск с Windows" 
                              IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" 
                              Margin="0,0,0,10" FontSize="12"
                              ToolTip="Программа будет автоматически стартовать в фоне при включении компьютера"/>
                    <CheckBox Content="Сворачивать в трей на [X]" 
                              IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" 
                              Margin="0,0,0,10" FontSize="12"/>
                    <CheckBox Content="Автозапуск обработки звука" 
                              IsChecked="{Binding AutoStartEngine, Mode=TwoWay}" 
                              Margin="0,0,0,4" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. FOOTER / HELP TIP -->
        <Border Grid.Row="3" Background="#1e2026" BorderBrush="#353742" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="💡" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" FontSize="12" Foreground="#e2e4e9" VerticalAlignment="Center" TextWrapping="Wrap">
                    <Run Text="Как это работает:" FontWeight="Bold" Foreground="#ffffff"/>
                    <Run Text=" 1) В поле «Выход» выберите виртуальный кабель (CABLE Input). 2) В Discord выберите CABLE Output как микрофон. 3) Закройте окно на крестик [X] или нажмите «Свернуть в трей» — компрессор останется работать в фоновом режиме в трее Windows."/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
