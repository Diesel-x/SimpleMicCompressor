<Window x:Class="MicCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MicCompressor.ViewModels"
        mc:Ignorable="d"
        Title="SimpleMicCompressor"
        Icon="assets/app.ico"
        Height="660" Width="980"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="#0c0e14"
        Foreground="#f3f4f6"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, Arial">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Studio Color Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#0c0e14"/>
        <SolidColorBrush x:Key="BgCard" Color="#151722"/>
        <SolidColorBrush x:Key="BgWell" Color="#10111a"/>
        <SolidColorBrush x:Key="BgInput" Color="#1c202e"/>
        <SolidColorBrush x:Key="BorderCard" Color="#232738"/>
        <SolidColorBrush x:Key="BorderLight" Color="#2d3348"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#2563eb"/>
        <SolidColorBrush x:Key="AccentBlueHover" Color="#3b82f6"/>
        <SolidColorBrush x:Key="GreenMeter" Color="#10b981"/>
        <SolidColorBrush x:Key="AmberMeter" Color="#f59e0b"/>
        <SolidColorBrush x:Key="RedDanger" Color="#ef4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#f9fafb"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#cbd5e1"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8b95a8"/>
        <SolidColorBrush x:Key="TextDarkMuted" Color="#525b70"/>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0c0e14"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0c0e14">
                                    <Track x:Name="PART_Track" IsDirectionReversed="true">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate>
                                                        <Border Background="#333b50" CornerRadius="3.5"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="#0c0e14">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate>
                                                        <Border Background="#333b50" CornerRadius="3.5"/>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Studio Sleek ScrollViewer Style (Removes standard grey/white corner boxes) -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Background" Value="#0c0e14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                   Grid.Column="0" Grid.Row="0"
                                                   CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1" Grid.Row="0"
                                       AutomationProperties.AutomationId="VerticalScrollBar"
                                       Cursor="Arrow"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Column="0" Grid.Row="1"
                                       AutomationProperties.AutomationId="HorizontalScrollBar"
                                       Cursor="Arrow"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Minimum="0"
                                       Orientation="Horizontal"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"/>
                            <Rectangle Grid.Column="1" Grid.Row="1" Fill="#0c0e14"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Professional Studio ComboBox Toggle Button -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="#1a1d28" BorderBrush="#2b3144" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8b95a8" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#ffffff" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#f1f3f7"/>
            <Setter Property="Background" Value="#1a1d28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter TextBlock.Foreground="#ffffff" TextBlock.FontSize="12"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2c3348"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#1a1d28"/>
            <Setter Property="BorderBrush" Value="#2b3144"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="false" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              TextBlock.Foreground="#ffffff"
                                              TextBlock.FontSize="12"
                                              TextBlock.FontWeight="SemiBold"
                                              Margin="10,0,28,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="true" Focusable="false" PopupAnimation="Fade">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="true" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                                    <Border x:Name="DropDownBorder" Background="#161822" 
                                            BorderBrush="#2d3348" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="true" Margin="4">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Precision Studio Fader / Slider -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#2563eb" Height="5" CornerRadius="2.5,0,0,2.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#202434" Height="5" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid Width="15" Height="20">
                                                    <Border Background="#2d3447" BorderBrush="#55607d" BorderThickness="1.5" CornerRadius="4">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.4"/>
                                                        </Border.Effect>
                                                        <!-- Fader cap center grip notch -->
                                                        <Rectangle Width="7" Height="1.5" Fill="#60a5fa" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Studio CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#f3f4f6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Standard Studio Card Container -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#151722"/>
            <Setter Property="BorderBrush" Value="#232738"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Studio Dark Expander for Advanced DSP Controls -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Background" Value="#10111a"/>
            <Setter Property="BorderBrush" Value="#232738"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="10,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                      TextBlock.FontSize="11"
                                                                      TextBlock.FontWeight="SemiBold"
                                                                      TextBlock.Foreground="#94a3b8"
                                                                      VerticalAlignment="Center"/>
                                                    <Path x:Name="Chevron" Grid.Column="1"
                                                          Data="M 0 0 L 4 4 L 8 0"
                                                          Stroke="#8b95a8" StrokeThickness="1.5"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="Data" Value="M 0 4 L 4 0 L 8 4"/>
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="#3b82f6"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chevron" Property="Stroke" Value="#ffffff"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="10,0,10,10"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- SCROLLABLE WORKSPACE (Auto-adapts to small & large screen resolutions) -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#0c0e14" BorderThickness="0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <!-- 1. Header Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. Quick Controls & VU Meters -->
                    <RowDefinition Height="Auto"/>
                    <!-- 3. 2-Column DSP Rack -->
                    <RowDefinition Height="*" MinHeight="270"/>
                    <!-- 4. Status Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <!-- ================================================================= -->
        <!-- 1. HEADER BAR (Clean Console Header)                              -->
        <!-- ================================================================= -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Monogram, Title, Status & Latency Badges -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563eb" Width="34" Height="34" CornerRadius="8" Margin="0,0,10,0">
                    <TextBlock Text="SMC" FontSize="12.5" FontWeight="ExtraBold" Foreground="#ffffff" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[App_Title]}" FontSize="13.5" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,7,0"/>
                        <Border Background="#1f2334" BorderBrush="#2e354c" BorderThickness="1" CornerRadius="4" Padding="5,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.3" FontSize="10" FontWeight="Bold" Foreground="#94a3b8"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding EngineStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EngineStatusText}" FontSize="11" Foreground="{Binding EngineStatusColor}" FontWeight="Bold" Margin="0,0,8,0"/>

                        <Border Background="#dc2626" CornerRadius="4" Padding="7,1"
                                Visibility="{Binding IsMuted, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding Loc[Badge_Muted]}" FontSize="10" FontWeight="Bold" Foreground="#ffffff"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Right: Profile Selector, Settings (⚙), Primary Engine Start/Stop -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#151722" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Loc[Header_Profile]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" Margin="4,0,6,0" VerticalAlignment="Center"/>

                        <ComboBox Width="140" Height="30" 
                                  ItemsSource="{Binding Presets}" 
                                  SelectedItem="{Binding SelectedPresetItem, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>

                        <Button Command="{Binding SaveProfileCommand}" 
                                ToolTip="{Binding SaveButtonToolTip}"
                                Height="30" Padding="7,0" Margin="4,0,0,0"
                                Background="#2563eb" Foreground="#ffffff" FontSize="11" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2 2 L 10 2 L 12 4 L 12 12 L 2 12 Z M 4 2 L 4 5 L 9 5 L 9 2 Z M 4 8 L 10 8 L 10 11 L 4 11 Z" 
                                      Stroke="#ffffff" StrokeThickness="1.2" Fill="Transparent" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[Action_Save]}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding OpenNewProfileDialogCommand}" 
                                ToolTip="{Binding Loc[Modal_NewProfile_Title]}"
                                Height="30" Padding="6,0" Margin="4,0,0,0"
                                Background="#1e2230" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6 2 L 6 10 M 2 6 L 10 6" 
                                      Stroke="#cbd5e1" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent" Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[Action_New]}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2c3348"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding DeleteProfileCommand}" 
                                Visibility="{Binding IsCustomProfileSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{Binding DeleteToolTip}"
                                Height="30" Width="28" Margin="4,0,0,0"
                                Background="#1e2230" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <Path Data="M 3 4 L 11 4 M 4.5 4 L 4.5 11 C 4.5 11.5 5 12 5.5 12 L 8.5 12 C 9 12 9.5 11.5 9.5 11 L 9.5 4 M 5.5 4 L 5.5 2.5 C 5.5 2 6 2 6.5 2 L 7.5 2 C 8 2 8.5 2 8.5 2.5 L 8.5 4" 
                                  Stroke="#f87171" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#451a20"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Settings Button (⚙) -->
                <Button Command="{Binding OpenSettingsDialogCommand}"
                        ToolTip="{Binding Loc[Modal_Settings_Title]}"
                        Height="34" Padding="9,0" Margin="0,0,6,0"
                        Background="#151722" Foreground="#cbd5e1" FontSize="11.5" FontWeight="SemiBold"
                        BorderBrush="#232738" BorderThickness="1" Cursor="Hand">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M 7 1 L 9 1 L 9.3 2.5 C 9.8 2.7 10.3 3 10.7 3.4 L 12.2 2.8 L 13.2 4.5 L 12 5.6 C 12.1 6.1 12.1 6.4 12.1 6.7 C 12.1 7 12.1 7.3 12 7.8 L 13.2 8.9 L 12.2 10.6 L 10.7 10 C 10.3 10.4 9.8 10.7 9.3 10.9 L 9 12.4 L 7 12.4 L 6.7 10.9 C 6.2 10.7 5.7 10.4 5.3 10 L 3.8 10.6 L 2.8 8.9 L 4 7.8 C 3.9 7.3 3.9 7 3.9 6.7 C 3.9 6.4 3.9 6.1 4 5.6 L 2.8 4.5 L 3.8 2.8 L 5.3 3.4 C 5.7 3 6.2 2.7 6.7 2.5 Z M 8 5 A 1.8 1.8 0 1 0 8 8.6 A 1.8 1.8 0 1 0 8 5 Z" 
                              Stroke="#cbd5e1" StrokeThickness="1" Fill="Transparent" Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Loc[Action_Settings]}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#222738"/>
                                    <Setter Property="Foreground" Value="#ffffff"/>
                                    <Setter Property="BorderBrush" Value="#353d56"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Primary Start / Stop Engine Button -->
                <Button Content="{Binding StartStopButtonText}" 
                        Command="{Binding ToggleEngineCommand}"
                        Width="98" Height="34" 
                        FontSize="11.5" FontWeight="Bold" Cursor="Hand"
                        Foreground="#ffffff" BorderThickness="0">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563eb"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="true">
                                    <Setter Property="Background" Value="#dc2626"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================================================================= -->
        <!-- 2. QUICK CONTROLS & STUDIO METERS                                 -->
        <!-- ================================================================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Card: Quick Controls (Mic Input + Mute / Bypass / Monitoring) -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 6 1 L 6 7 M 4 4 L 8 4 M 3 7 C 3 9 4.5 10.5 6 10.5 C 7.5 10.5 9 9 9 7 M 6 10.5 L 6 13 M 4 13 L 8 13" 
                                  Stroke="#3b82f6" StrokeThickness="1.3" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Quick_Controls]}" FontSize="11" FontWeight="Bold" Foreground="#8b95a8"/>
                        </StackPanel>
                        <Button Content="{Binding Loc[Routing_Refresh]}" Command="{Binding RefreshDevicesCommand}" 
                                HorizontalAlignment="Right" Background="Transparent" Foreground="#3b82f6" 
                                BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Microphone Selector -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Loc[Routing_Input]}" FontSize="12" FontWeight="SemiBold" Foreground="#8b95a8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InputDevices}" 
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="32"/>
                    </Grid>

                    <!-- 3 Toggle Cards: Mute / Bypass / Monitoring -->
                    <Grid Grid.Row="2" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1.45*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mute Pill -->
                        <Border Grid.Column="0" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="Mute" FontSize="12" FontWeight="Bold" Foreground="#ef4444" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsMuted, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Loc[FX_Mute_Desc]}" FontSize="10" Foreground="#8b95a8" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Bypass Pill -->
                        <Border Grid.Column="2" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10,9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Loc[Action_Bypass]}" FontSize="12" FontWeight="Bold" Foreground="#38bdf8" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding BypassAll, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Loc[FX_Bypass_Desc]}" FontSize="10" Foreground="#8b95a8" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Monitoring Pill + Inline Volume Slider -->
                        <Border Grid.Column="4" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,4">
                                    <TextBlock Text="{Binding Loc[Routing_Monitor]}" FontSize="12" FontWeight="Bold" Foreground="#10b981" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding MonitorEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Slider Grid.Row="1" Minimum="0.0" Maximum="1.0"
                                        Value="{Binding MonitorVolume, Mode=TwoWay}"
                                        IsEnabled="{Binding MonitorEnabled}"
                                        ToolTip="{Binding Loc[Routing_MonitorVolume]}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card: Studio Level Meters -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M 1 12 L 3 12 L 3 4 L 1 4 Z M 5 12 L 7 12 L 7 1 L 5 1 Z M 9 12 L 11 12 L 11 7 L 9 7 Z" 
                                  Stroke="#10b981" StrokeThickness="1" Fill="#10b981" Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Loc[Card_Meters]}" FontSize="11" FontWeight="Bold" Foreground="#8b95a8"/>
                        </StackPanel>
                        <!-- Live Gate Indicator Badge -->
                        <Border HorizontalAlignment="Right" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="4" Padding="6,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Loc[Meters_Gate]}" FontSize="10" FontWeight="SemiBold" Foreground="#8b95a8" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding GateStatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding GateStatusColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Input Level -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Meters_Input]}" FontSize="11" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding InputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#10b981"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#10111a" BorderBrush="#1f2334" BorderThickness="1" Height="12" CornerRadius="4" Padding="1">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding InputMeterPercent, Mode=OneWay}" 
                                         Height="8" Background="Transparent" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#10b981" Offset="0.0"/>
                                        <GradientStop Color="#10b981" Offset="0.75"/>
                                        <GradientStop Color="#f59e0b" Offset="0.90"/>
                                        <GradientStop Color="#ef4444" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Border>
                    </Grid>

                    <!-- Gain Reduction -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Meters_GR]}" FontSize="11" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding GainReductionDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#f59e0b"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#10111a" BorderBrush="#1f2334" BorderThickness="1" Height="12" CornerRadius="4" Padding="1">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GainReductionMeterPercent, Mode=OneWay}" 
                                         Height="8" Foreground="#f59e0b" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- Output Level -->
                    <Grid Grid.Row="3" Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Meters_Output]}" FontSize="11" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding OutputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#10111a" BorderBrush="#1f2334" BorderThickness="1" Height="12" CornerRadius="4" Padding="1">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding OutputMeterPercent, Mode=OneWay}" 
                                         Height="8" Background="Transparent" BorderThickness="0">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#06b6d4" Offset="0.0"/>
                                        <GradientStop Color="#3b82f6" Offset="0.85"/>
                                        <GradientStop Color="#ef4444" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </Border>
                    </Grid>

                    <!-- Decibel Scale Graduation Marks -->
                    <Grid Grid.Row="4" Margin="2,2,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="-48" FontSize="9" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Grid.Column="1" Text="-36" FontSize="9" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Grid.Column="2" Text="-24" FontSize="9" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Grid.Column="3" Text="-12" FontSize="9" FontWeight="SemiBold" Foreground="#475569"/>
                        <TextBlock Grid.Column="4" Text="-6" FontSize="9" FontWeight="SemiBold" Foreground="#64748b"/>
                        <TextBlock Grid.Column="5" Text="0 dB" FontSize="9" FontWeight="Bold" Foreground="#ef4444"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 3. CLEAN 2-COLUMN DSP RACK                                        -->
        <!-- ================================================================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUMN 0: GATE, FILTERS & FX -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <!-- Noise Gate Header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#10b981" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0">
                                <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Loc[Card_Gate]}" FontSize="12" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding GateEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Gate Threshold Slider -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Gate_Threshold]}" FontSize="11.5" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding GateThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="-60" Maximum="-20" Value="{Binding GateThresholdDb, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"
                                ToolTip="{Binding Loc[Gate_Threshold_Tip]}"/>
                    </StackPanel>

                    <!-- Gate Release Slider -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Gate_Release]}" FontSize="11.5" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding GateReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="20" Maximum="400" Value="{Binding GateReleaseMs, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"
                                ToolTip="{Binding Loc[Gate_Release_Tip]}"/>
                    </StackPanel>

                    <!-- Compact FX Toggles: Low-Cut & Limiter -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Loc[FX_LowCut]}" FontSize="11" FontWeight="Bold" Foreground="#ffffff"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Loc[FX_LowCut_Tip]}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding HighPassEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Loc[FX_Limiter]}" FontSize="11" FontWeight="Bold" Foreground="#ffffff"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Loc[FX_Limiter_Sub]}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Meme Mode Overdrive -->
                    <Border Background="#1f1418" BorderBrush="#3f1f26" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{Binding Loc[FX_Meme]}" FontSize="11.5" FontWeight="Bold" Foreground="#f87171" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding DestroyedMicMemeMode, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Loc[FX_Meme_Notice]}" 
                                       FontSize="10" FontWeight="SemiBold" Foreground="#fbbf24" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- COLUMN 1: DYNAMIC COMPRESSOR -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563eb" Width="18" Height="18" CornerRadius="4" Margin="0,0,8,0">
                                <TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Loc[Card_Compressor]}" FontSize="12" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Threshold Slider -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Comp_Threshold]}" FontSize="11.5" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding CompressorThresholdDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="-40" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="{Binding Loc[Comp_Threshold_Tip]}"/>
                    </StackPanel>

                    <!-- Ratio Slider -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Comp_Ratio]}" FontSize="11.5" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding CompressorRatio, StringFormat={}{0:F1}:1}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="1.5" Maximum="10.0" Value="{Binding CompressorRatio, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="{Binding Loc[Comp_Ratio_Tip]}"/>
                    </StackPanel>

                    <!-- Makeup Gain Slider -->
                    <StackPanel Margin="0,0,0,12">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="{Binding Loc[Comp_Makeup]}" FontSize="11.5" Foreground="#cbd5e1"/>
                            <TextBlock Text="{Binding CompressorMakeupGainDb, StringFormat=+{0:F1} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#10b981"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="18" Value="{Binding CompressorMakeupGainDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="{Binding Loc[Comp_Makeup_Tip]}"/>
                    </StackPanel>

                    <!-- Collapsible Advanced Attack & Release -->
                    <Expander Header="{Binding Loc[Comp_Advanced]}" IsExpanded="False">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Loc[Comp_Attack]}" FontSize="11" Foreground="#8b95a8"/>
                                    <TextBlock Text="{Binding CompressorAttackMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#ffffff"/>
                                </Grid>
                                <Slider Minimum="1" Maximum="40" Value="{Binding CompressorAttackMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="{Binding Loc[Comp_Release]}" FontSize="11" Foreground="#8b95a8"/>
                                    <TextBlock Text="{Binding CompressorReleaseMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#ffffff"/>
                                </Grid>
                                <Slider Minimum="30" Maximum="400" Value="{Binding CompressorReleaseMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 4. MINIMAL STATUS FOOTER                                          -->
        <!-- ================================================================= -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="{Binding StatusNotification}" HorizontalAlignment="Left" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" VerticalAlignment="Center"/>

            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#475569" VerticalAlignment="Center">
                <Run Text="{Binding Loc[Footer_Developer], Mode=OneWay}"/>
                <Hyperlink NavigateUri="https://github.com/Diesel-x/Simple_Mic_Compressor" RequestNavigate="OnHyperlinkRequestNavigate" Foreground="#38bdf8" TextDecorations="None" Cursor="Hand">
                    <Run Text="Diesel-X" FontWeight="Bold"/>
                </Hyperlink>
            </TextBlock>
        </Grid>
            </Grid>
        </ScrollViewer>

        <!-- ================================================================= -->
        <!-- 5. MODAL: SAVE NEW PROFILE DIALOG                                 -->
        <!-- ================================================================= -->
        <Grid Visibility="{Binding IsSaveProfileDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#b3000000" Panel.ZIndex="300">
            <Border Background="#161822" BorderBrush="#2e354c" BorderThickness="1.5" CornerRadius="12"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Modal_NewProfile_Title]}" FontSize="15" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Loc[Modal_NewProfile_Desc]}" 
                               FontSize="12" Foreground="#8b95a8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="16"/>

                    <TextBlock Text="{Binding Loc[Modal_NewProfile_Field]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewProfileTextBox"
                             Text="{Binding ProfileNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1c202e" Foreground="#ffffff" BorderBrush="#2563eb" BorderThickness="1.5"
                             Padding="10,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc[Modal_Cancel]}" Command="{Binding CancelSaveProfileCommand}"
                                IsCancel="True"
                                Height="34" Background="#202434" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2c3348"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="{Binding Loc[Modal_Save]}" Command="{Binding ConfirmSaveProfileCommand}"
                                IsDefault="True"
                                Height="34" Background="#2563eb" Foreground="#ffffff" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 6. MODAL: GLOBAL HOTKEYS DIALOG                                   -->
        <!-- ================================================================= -->
        <Grid Visibility="{Binding IsHotkeysDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#b3000000" Panel.ZIndex="300">
            <Border Background="#161822" BorderBrush="#2e354c" BorderThickness="1.5" CornerRadius="12"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding Loc[Modal_Hotkeys_Title]}" FontSize="15" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding Loc[Modal_Hotkeys_Desc]}" 
                               FontSize="12" Foreground="#8b95a8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="16"/>

                    <CheckBox Content="{Binding Loc[Modal_Hotkeys_Enable]}"
                              IsChecked="{Binding HotkeysEnabled, Mode=TwoWay}"
                              Margin="0,0,0,14" FontSize="12.5" FontWeight="SemiBold"/>

                    <!-- Hotkey 1: Bypass -->
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Loc[Hotkeys_Bypass]}" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding HotkeyBypass.Enabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding HotkeyBypass.Enabled}">
                                <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyBypass.Ctrl, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Shift" IsChecked="{Binding HotkeyBypass.Shift, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Alt" IsChecked="{Binding HotkeyBypass.Alt, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox Width="75" Height="28" ItemsSource="{Binding AvailableHotkeyKeys}" SelectedItem="{Binding HotkeyBypass.Key, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hotkey 2: Meme Mode -->
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Loc[Hotkeys_Meme]}" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding HotkeyMeme.Enabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding HotkeyMeme.Enabled}">
                                <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyMeme.Ctrl, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Shift" IsChecked="{Binding HotkeyMeme.Shift, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Alt" IsChecked="{Binding HotkeyMeme.Alt, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox Width="75" Height="28" ItemsSource="{Binding AvailableHotkeyKeys}" SelectedItem="{Binding HotkeyMeme.Key, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Hotkey 3: Mute -->
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Loc[Hotkeys_Mute]}" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                                <CheckBox IsChecked="{Binding HotkeyMute.Enabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding HotkeyMute.Enabled}">
                                <CheckBox Content="Ctrl" IsChecked="{Binding HotkeyMute.Ctrl, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Shift" IsChecked="{Binding HotkeyMute.Shift, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <CheckBox Content="Alt" IsChecked="{Binding HotkeyMute.Alt, Mode=TwoWay}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="14" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ComboBox Width="75" Height="28" ItemsSource="{Binding AvailableHotkeyKeys}" SelectedItem="{Binding HotkeyMute.Key, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{Binding Loc[Modal_Reset]}" Command="{Binding ResetHotkeysCommand}"
                                Height="34" Padding="12,0" Background="#202434" Foreground="#cbd5e1" FontSize="11.5" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                        <Button Grid.Column="2" Content="{Binding Loc[Modal_Close]}" Command="{Binding CloseHotkeysDialogCommand}"
                                IsDefault="True"
                                Height="34" Padding="16,0" Background="#2563eb" Foreground="#ffffff" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 7. MODAL: APPLICATION SETTINGS & UNINSTALLATION DIALOG            -->
        <!-- ================================================================= -->
        <Grid Visibility="{Binding IsSettingsDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#b3000000" Panel.ZIndex="300">
            <Border Background="#161822" BorderBrush="#2e354c" BorderThickness="1.5" CornerRadius="12"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" Background="Transparent">
                    <StackPanel Margin="0,0,4,0">
                        <!-- Settings Title -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 7 1 L 9 1 L 9.3 2.5 C 9.8 2.7 10.3 3 10.7 3.4 L 12.2 2.8 L 13.2 4.5 L 12 5.6 C 12.1 6.1 12.1 6.4 12.1 6.7 C 12.1 7 12.1 7.3 12 7.8 L 13.2 8.9 L 12.2 10.6 L 10.7 10 C 10.3 10.4 9.8 10.7 9.3 10.9 L 9 12.4 L 7 12.4 L 6.7 10.9 C 6.2 10.7 5.7 10.4 5.3 10 L 3.8 10.6 L 2.8 8.9 L 4 7.8 C 3.9 7.3 3.9 7 3.9 6.7 C 3.9 6.4 3.9 6.1 4 5.6 L 2.8 4.5 L 3.8 2.8 L 5.3 3.4 C 5.7 3 6.2 2.7 6.7 2.5 Z M 8 5 A 1.8 1.8 0 1 0 8 8.6 A 1.8 1.8 0 1 0 8 5 Z" 
                                      Stroke="#3b82f6" StrokeThickness="1.2" Fill="Transparent" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Loc[Modal_Settings_Title]}" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                            </StackPanel>
                            <Button Content="✕" Command="{Binding CloseSettingsDialogCommand}"
                                    HorizontalAlignment="Right" Background="Transparent" Foreground="#8b95a8" 
                                    BorderThickness="0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                        </Grid>

                        <!-- Section 1: Devices & SMC virtual cable -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding Loc[Settings_AudioCable]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" VerticalAlignment="Center"/>
                            <Button Content="{Binding Loc[Routing_Refresh]}" Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Right" Background="Transparent" Foreground="#3b82f6"
                                    BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="Bold"/>
                        </Grid>
                        <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <!-- Virtual Cable Status + Install/Reinstall -->
                                <Border Background="#151722" BorderBrush="#232738" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Loc[Cable_NotFound]}"/>
                                                        <Setter Property="Foreground" Value="#f59e0b"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                                <Setter Property="Text" Value="{Binding Loc[Cable_Active]}"/>
                                                                <Setter Property="Foreground" Value="#10b981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Grid.Column="1" Cursor="Hand" FontSize="10.5" FontWeight="Bold" Padding="10,5" Foreground="#ffffff" BorderThickness="0" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#2563eb"/>
                                                        <Setter Property="Content" Value="{Binding Loc[Cable_Install]}"/>
                                                        <Setter Property="Command" Value="{Binding InstallVbCableCommand}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                                <Setter Property="Background" Value="#222738"/>
                                                                <Setter Property="Content" Value="{Binding Loc[Cable_Reinstall]}"/>
                                                                <Setter Property="Command" Value="{Binding ReinstallVbCableCommand}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                                <Setter Property="Content" Value="{Binding Loc[Cable_Installing]}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        <TextBlock Text="{Binding InstallerStatus, TargetNullValue=''}" FontSize="10.5" Foreground="#38bdf8" TextWrapping="Wrap" Margin="0,5,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Virtual Output Cable Selector -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Routing_Output]}" FontSize="12" FontWeight="SemiBold" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Height="30"
                                              ItemsSource="{Binding OutputDevices}"
                                              SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding HasVirtualCable}"/>
                                </Grid>

                                <!-- Monitor Headphones Selector -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Routing_Monitor]}" FontSize="12" FontWeight="SemiBold" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Height="30"
                                              ItemsSource="{Binding MonitorDevices}"
                                              SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                              DisplayMemberPath="Name"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 2: General Preferences -->
                        <TextBlock Text="{Binding Loc[Settings_General]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,0,6"/>
                        <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox Content="{Binding Loc[Pref_AutoStart]}" 
                                          IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" 
                                          Margin="0,0,0,8" FontSize="12"/>
                                <CheckBox Content="{Binding Loc[Pref_MinimizeClose]}" 
                                          IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" 
                                          Margin="0,0,0,10" FontSize="12"/>

                                <!-- Language Selector -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Loc[Action_Language]}" FontSize="12" FontWeight="SemiBold" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Height="30"
                                              ItemsSource="{Binding AvailableLanguages}"
                                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"/>
                                </Grid>

                                <!-- Hotkeys & Setup Wizard Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Loc[Btn_HotkeysConfig]}" Command="{Binding OpenHotkeysDialogCommand}"
                                            Height="32" Background="#1e2230" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold" BorderBrush="#2b3144" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                    <Button Grid.Column="2" Content="{Binding Loc[Wizard_OpenBtn]}" Command="{Binding OpenOnboardingCommand}"
                                            Height="32" Background="#1e2230" Foreground="#cbd5e1" FontSize="11" FontWeight="SemiBold" BorderBrush="#2b3144" BorderThickness="1" Cursor="Hand">
                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Section 3: Danger Zone / Uninstallation -->
                        <TextBlock Text="{Binding Loc[Settings_DangerZone]}" FontSize="10" FontWeight="Bold" Foreground="#ef4444" Margin="0,0,0,6"/>
                        <Border Background="#1b1216" BorderBrush="#3f1f26" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Loc[Pref_Uninstall]}" FontSize="12" FontWeight="Bold" Foreground="#f87171"/>
                                    <TextBlock Text="{Binding Loc[Pref_Uninstall_Tip]}" FontSize="10.5" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding FullUninstallCommand}"
                                        Content="{Binding Loc[Pref_Uninstall]}"
                                        Height="32" Padding="12,0" Background="#2b151a" BorderBrush="#50242d" BorderThickness="1" 
                                        Foreground="#f87171" FontSize="11" FontWeight="Bold" Cursor="Hand">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#451a20"/>
                                                    <Setter Property="BorderBrush" Value="#7f1d1d"/>
                                                    <Setter Property="Foreground" Value="#ffffff"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modal Actions -->
                        <Button Content="{Binding Loc[Modal_Close]}" Command="{Binding CloseSettingsDialogCommand}"
                                IsDefault="True"
                                Height="34" Background="#2563eb" Foreground="#ffffff" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 8. MODAL: FIRST-RUN SETUP WIZARD                                  -->
        <!-- ================================================================= -->
        <Grid Visibility="{Binding IsOnboardingVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#cc000000" Panel.ZIndex="400">
            <Border Background="#161822" BorderBrush="#2e354c" BorderThickness="1.5" CornerRadius="12"
                    Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.75"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Wizard Header + Language Switcher -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#2563eb" Width="26" Height="26" CornerRadius="6" Margin="0,0,10,0">
                                <TextBlock Text="SMC" FontSize="10" FontWeight="ExtraBold" Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Loc[Wizard_Title]}" FontSize="16" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="130" Height="28"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName"/>
                    </Grid>

                    <TextBlock Text="{Binding Loc[Wizard_Subtitle]}" FontSize="12" Foreground="#8b95a8" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="17"/>

                    <!-- Step 1: Microphone -->
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding Loc[Wizard_Step_Mic]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" VerticalAlignment="Center"/>
                        <Button Content="{Binding Loc[Routing_Refresh]}" Command="{Binding RefreshDevicesCommand}"
                                HorizontalAlignment="Right" Background="Transparent" Foreground="#3b82f6"
                                BorderThickness="0" Cursor="Hand" FontSize="10.5" FontWeight="Bold"/>
                    </Grid>
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="32"/>
                    </Border>

                    <!-- Step 2: SMC virtual cable Setup -->
                    <TextBlock Text="{Binding Loc[Wizard_Step_Cable]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,0,4"/>
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Loc[Cable_NotFound]}"/>
                                            <Setter Property="Foreground" Value="#f59e0b"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Loc[Cable_Active]}"/>
                                                    <Setter Property="Foreground" Value="#10b981"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button Grid.Column="1" Cursor="Hand" FontSize="11" FontWeight="Bold" Padding="12,6" Foreground="#ffffff" BorderThickness="0" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#2563eb"/>
                                            <Setter Property="Content" Value="{Binding Loc[Cable_Install]}"/>
                                            <Setter Property="Command" Value="{Binding InstallVbCableCommand}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                    <Setter Property="Background" Value="#222738"/>
                                                    <Setter Property="Content" Value="{Binding Loc[Cable_Reinstall]}"/>
                                                    <Setter Property="Command" Value="{Binding ReinstallVbCableCommand}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Content" Value="{Binding Loc[Cable_Installing]}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding InstallerStatus, TargetNullValue=''}" FontSize="10.5" Foreground="#38bdf8" TextWrapping="Wrap" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Monitor Headphones -->
                    <TextBlock Text="{Binding Loc[Wizard_Step_Monitor]}" FontSize="10" FontWeight="Bold" Foreground="#8b95a8" Margin="0,0,0,4"/>
                    <Border Background="#10111a" BorderBrush="#232738" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,18">
                        <ComboBox ItemsSource="{Binding MonitorDevices}"
                                  SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="32"/>
                    </Border>

                    <!-- Done Button -->
                    <Button Content="{Binding Loc[Wizard_Done]}" Command="{Binding CompleteOnboardingCommand}"
                            IsDefault="True"
                            Height="38" Background="#2563eb" Foreground="#ffffff" FontSize="12.5" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7"/></Style></Button.Resources>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1d4ed8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
