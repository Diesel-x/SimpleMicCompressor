<Window x:Class="MicCompressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MicCompressor.ViewModels"
        mc:Ignorable="d"
        Title="MicCompressor"
        Height="820" Width="1060"
        MinHeight="760" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#131418"
        Foreground="#f1f3f7"
        FontFamily="Segoe UI, Segoe UI Variable, -apple-system, Arial">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Palette: Studio Charcoal & Precision Accents -->
        <SolidColorBrush x:Key="BgDark" Color="#131418"/>
        <SolidColorBrush x:Key="BgCard" Color="#1b1c22"/>
        <SolidColorBrush x:Key="BgCardInner" Color="#22242c"/>
        <SolidColorBrush x:Key="BgInput" Color="#272932"/>
        <SolidColorBrush x:Key="BorderCard" Color="#2d303b"/>
        <SolidColorBrush x:Key="BorderLight" Color="#3b3f4d"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#3b82f6"/>
        <SolidColorBrush x:Key="GreenMeter" Color="#10b981"/>
        <SolidColorBrush x:Key="AmberMeter" Color="#f59e0b"/>
        <SolidColorBrush x:Key="RedDanger" Color="#ef4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#c5cad6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8b92a4"/>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Background="#414554" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Professional Studio ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6"
                        Background="#252731" BorderBrush="#353846" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#8b92a4" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#ffffff" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#3b82f6" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#f1f3f7"/>
            <Setter Property="Background" Value="#252731"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter TextBlock.Foreground="#ffffff" TextBlock.FontSize="12.5"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#323543"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2563eb"/>
                                <Setter Property="Foreground" Value="#ffffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="Background" Value="#252731"/>
            <Setter Property="BorderBrush" Value="#353846"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="false" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              TextBlock.Foreground="#ffffff"
                                              TextBlock.FontSize="12.5"
                                              TextBlock.FontWeight="SemiBold"
                                              Margin="10,0,28,0" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="true" Focusable="false" PopupAnimation="Fade">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="true" 
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="280">
                                    <Border x:Name="DropDownBorder" Background="#1e2027" 
                                            BorderBrush="#353846" BorderThickness="1" CornerRadius="6" Margin="0,3,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="true" Margin="4">
                                            <StackPanel IsItemsHost="true" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Studio Fader / Slider -->
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#3b82f6" Height="5" CornerRadius="2.5,0,0,2.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="#2a2c37" Height="5" CornerRadius="0,2.5,2.5,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border Width="16" Height="16" CornerRadius="8" Background="#ffffff" BorderBrush="#3b82f6" BorderThickness="2.5">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Studio CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="#1b1c22"/>
            <Setter Property="BorderBrush" Value="#2b2d37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 1. Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 2. Devices & VU Meters -->
            <RowDefinition Height="Auto"/>
            <!-- 3. Channel Strip (DSP Controls) -->
            <RowDefinition Height="*"/>
            <!-- 4. Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App Title & Engine Telemetry -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2563eb" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0">
                    <TextBlock Text="MC" FontSize="15" FontWeight="ExtraBold" Foreground="#ffffff" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MIC COMPRESSOR" FontSize="15" FontWeight="Bold" Foreground="#ffffff"/>
                        <Border Background="#22242c" BorderBrush="#353846" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="WASAPI DSP" FontSize="10.5" FontWeight="Bold" Foreground="#9ba2b5"/>
                        </Border>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="8" Height="8" Fill="{Binding EngineStatusColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding EngineStatusText}" FontSize="11.5" Foreground="{Binding EngineStatusColor}" FontWeight="Bold" Margin="0,0,12,0"/>

                        <!-- Real-time Latency Indicator -->
                        <Border Background="#1f2129" BorderBrush="#323542" BorderThickness="1" CornerRadius="4" Padding="6,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="LATENCY: " FontSize="10.5" FontWeight="SemiBold" Foreground="#8b92a4"/>
                                <TextBlock Text="{Binding LatencyDisplay}" FontSize="10.5" FontWeight="Bold" Foreground="#38bdf8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Top Right: Profiles, Bypass, Power -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Preset / Profile Selector & Actions -->
                <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="ПРОФИЛЬ" FontSize="10" FontWeight="Bold" Foreground="#8b92a4" Margin="0,0,0,3"/>
                    <StackPanel Orientation="Horizontal">
                        <!-- Dropdown -->
                        <ComboBox Width="185" Height="32" 
                                  ItemsSource="{Binding Presets}" 
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"/>

                        <!-- Save Button (Updates current profile or prompts for new) -->
                        <Button Command="{Binding SaveProfileCommand}" 
                                ToolTip="{Binding SaveButtonToolTip}"
                                Height="32" Padding="10,0" Margin="5,0,0,0"
                                Background="#2563eb" Foreground="#ffffff" FontSize="11.5" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2 2 L 10 2 L 12 4 L 12 12 L 2 12 Z M 4 2 L 4 5 L 9 5 L 9 2 Z M 4 8 L 10 8 L 10 11 L 4 11 Z" 
                                      Stroke="#ffffff" StrokeThickness="1.2" Fill="Transparent" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Сохранить" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- New Profile Button (+) -->
                        <Button Command="{Binding OpenNewProfileDialogCommand}" 
                                ToolTip="Создать новый профиль из текущих настроек..."
                                Height="32" Padding="8,0" Margin="4,0,0,0"
                                Background="#252731" Foreground="#c5cad6" FontSize="11.5" FontWeight="SemiBold"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6 2 L 6 10 M 2 6 L 10 6" 
                                      Stroke="#c5cad6" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent" Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Новый" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#323543"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Delete Button (Only visible for custom profiles) -->
                        <Button Command="{Binding DeleteProfileCommand}" 
                                Visibility="{Binding IsCustomProfileSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="{Binding DeleteToolTip}"
                                Height="32" Width="32" Margin="4,0,0,0"
                                Background="#252731" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style></Button.Resources>
                            <Path Data="M 3 4 L 11 4 M 4.5 4 L 4.5 11 C 4.5 11.5 5 12 5.5 12 L 8.5 12 C 9 12 9.5 11.5 9.5 11 L 9.5 4 M 5.5 4 L 5.5 2.5 C 5.5 2 6 2 6.5 2 L 7.5 2 C 8 2 8.5 2 8.5 2.5 L 8.5 4" 
                                  Stroke="#f87171" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Fill="Transparent" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#451a20"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- Bypass Toggle -->
                <CheckBox Content="Bypass" 
                          IsChecked="{Binding BypassAll, Mode=TwoWay}"
                          VerticalAlignment="Center" Margin="0,12,12,0"
                          ToolTip="Отключить всю обработку (исходный звук микрофона)"/>

                <!-- Minimize to Tray Button -->
                <Button Content="В трей" 
                        Click="OnMinimizeToTrayClicked"
                        Width="70" Height="32" 
                        Margin="0,10,8,0"
                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand"
                        Foreground="#c5cad6" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#252731"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#323543"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Start / Stop Engine Button -->
                <Button Content="{Binding StartStopButtonText}" 
                        Command="{Binding ToggleEngineCommand}"
                        Width="115" Height="32" 
                        Margin="0,10,0,0"
                        FontSize="12" FontWeight="Bold" Cursor="Hand"
                        Foreground="#ffffff" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#2563eb"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="10,4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="true">
                                    <Setter Property="Background" Value="#dc2626"/>
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. DEVICES & METERS (Top Panel) -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card: Audio Routing -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="МАРШРУТИЗАЦИЯ ЗВУКА" FontSize="11" FontWeight="Bold" Foreground="#8b92a4"/>
                        <Button Content="Обновить" Command="{Binding RefreshDevicesCommand}" 
                                HorizontalAlignment="Right" Background="Transparent" Foreground="#3b82f6" 
                                BorderThickness="0" Cursor="Hand" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Mic Input -->
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Вход:" FontSize="12" FontWeight="SemiBold" Foreground="#8b92a4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InputDevices}" 
                                  SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="30"/>
                    </Grid>

                    <!-- Output (Cable or Speakers) -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Выход:" FontSize="12" FontWeight="SemiBold" Foreground="#8b92a4" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" 
                                  SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="30"/>
                    </Grid>

                    <!-- Virtual Cable Installer Strip -->
                    <Border Grid.Row="3" Background="#16171d" BorderBrush="#2d303b" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Виртуальный кабель не обнаружен (нужен для Discord)"/>
                                        <Setter Property="Foreground" Value="#f59e0b"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                <Setter Property="Text" Value="Виртуальный кабель активен. В Discord выберите CABLE Output"/>
                                                <Setter Property="Foreground" Value="#10b981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Button Grid.Column="1" Cursor="Hand" FontSize="11" FontWeight="Bold" Padding="10,4" Foreground="#ffffff" BorderThickness="0" Margin="8,0,0,0">
                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#2563eb"/>
                                        <Setter Property="Content" Value="Установить кабель"/>
                                        <Setter Property="Command" Value="{Binding InstallVbCableCommand}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVirtualCable}" Value="True">
                                                <Setter Property="Background" Value="#2b2d38"/>
                                                <Setter Property="Content" Value="Переустановить"/>
                                                <Setter Property="Command" Value="{Binding ReinstallVbCableCommand}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="Установка..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Headphone Monitor -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Мониторинг" 
                                  IsChecked="{Binding MonitorEnabled, Mode=TwoWay}" 
                                  VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding MonitorDevices}" 
                                  SelectedItem="{Binding SelectedMonitorDevice, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Height="28" FontSize="11.5"
                                  IsEnabled="{Binding MonitorEnabled}" Margin="0,0,8,0"/>
                        <Slider Grid.Column="2" Minimum="0.0" Maximum="1.0" 
                                Value="{Binding MonitorVolume, Mode=TwoWay}" 
                                IsEnabled="{Binding MonitorEnabled}"
                                ToolTip="Громкость самопрослушивания"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Card: Studio Level Meters -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="ИНДИКАТОРЫ УРОВНЯ" FontSize="11" FontWeight="Bold" Foreground="#8b92a4"/>
                        <Border HorizontalAlignment="Right" Background="#242630" CornerRadius="4" Padding="6,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="GATE: " FontSize="10.5" FontWeight="SemiBold" Foreground="#8b92a4"/>
                                <TextBlock Text="{Binding GateStatusText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding GateStatusColor}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Input Level -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Вход (Микрофон)" FontSize="11" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding InputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#10b981"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#16171d" Height="10" CornerRadius="5">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding InputMeterPercent, Mode=OneWay}" 
                                         Height="10" Foreground="#10b981" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- Gain Reduction -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Сжатие компрессора (GR)" FontSize="11" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding GainReductionDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#f59e0b"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#16171d" Height="10" CornerRadius="5">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding GainReductionMeterPercent, Mode=OneWay}" 
                                         Height="10" Foreground="#f59e0b" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>

                    <!-- Output Level -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,3">
                            <TextBlock Text="Выход (В эфир)" FontSize="11" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding OutputPeakDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#16171d" Height="10" CornerRadius="5">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding OutputMeterPercent, Mode=OneWay}" 
                                         Height="10" Foreground="#38bdf8" Background="Transparent" BorderThickness="0"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. CHANNEL STRIP: GATE | COMPRESSOR | MASTER & FX -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- MODULE 1: NOISE GATE -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="NOISE GATE" FontSize="12" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding GateEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Threshold -->
                    <StackPanel Margin="0,0,0,14">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Порог (Threshold)" FontSize="12" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding GateThresholdDb, StringFormat={}{0:F0} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="-60" Maximum="-20" Value="{Binding GateThresholdDb, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"
                                ToolTip="Уровень громкости, ниже которого микрофон автоматически глушится"/>
                    </StackPanel>

                    <!-- Release -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Затухание (Release)" FontSize="12" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding GateReleaseMs, StringFormat={}{0:F0} ms}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="20" Maximum="400" Value="{Binding GateReleaseMs, Mode=TwoWay}" IsEnabled="{Binding GateEnabled}"
                                ToolTip="Время плавного закрытия гейта (сохраняет тихие окончания слов)"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- MODULE 2: COMPRESSOR -->
            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="COMPRESSOR" FontSize="12" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                        <CheckBox IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Threshold -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Порог (Threshold)" FontSize="12" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding CompressorThresholdDb, StringFormat={}{0:F1} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="-40" Maximum="0" Value="{Binding CompressorThresholdDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="Громкость, выше которой сигнал начинает сжиматься"/>
                    </StackPanel>

                    <!-- Ratio -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Сжатие (Ratio)" FontSize="12" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding CompressorRatio, StringFormat={}{0:F1}:1}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#38bdf8"/>
                        </Grid>
                        <Slider Minimum="1.5" Maximum="10.0" Value="{Binding CompressorRatio, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="Степень подавления громких звуков"/>
                    </StackPanel>

                    <!-- Makeup Gain -->
                    <StackPanel Margin="0,0,0,10">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="Усиление (Makeup Gain)" FontSize="12" Foreground="#c5cad6"/>
                            <TextBlock Text="{Binding CompressorMakeupGainDb, StringFormat=+{0:F1} dB}" HorizontalAlignment="Right" FontSize="12" FontWeight="Bold" Foreground="#10b981"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="18" Value="{Binding CompressorMakeupGainDb, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"
                                ToolTip="Компенсация общей громкости после сжатия"/>
                    </StackPanel>

                    <!-- Attack & Release Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Атака" FontSize="11.5" Foreground="#8b92a4"/>
                                <TextBlock Text="{Binding CompressorAttackMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#ffffff"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="40" Value="{Binding CompressorAttackMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Спад" FontSize="11.5" Foreground="#8b92a4"/>
                                <TextBlock Text="{Binding CompressorReleaseMs, StringFormat={}{0:F0}ms}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="Bold" Foreground="#ffffff"/>
                            </Grid>
                            <Slider Minimum="30" Maximum="400" Value="{Binding CompressorReleaseMs, Mode=TwoWay}" IsEnabled="{Binding CompressorEnabled}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- MODULE 3: MASTER & FX -->
            <Border Grid.Column="4" Style="{StaticResource CardPanel}">
                <StackPanel>
                    <TextBlock Text="MASTER &amp; FX" FontSize="12" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,12"/>

                    <!-- Low-Cut Filter -->
                    <Border Background="#22242c" BorderBrush="#2e313c" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <TextBlock Text="Low-Cut 80 Hz (Срез гула)" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding HighPassEnabled, Mode=TwoWay}" HorizontalAlignment="Right"
                                      ToolTip="Срезает низкочастотный гул микрофона и удары по столу"/>
                        </Grid>
                    </Border>

                    <!-- Limiter -->
                    <Border Background="#22242c" BorderBrush="#2e313c" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Пик-лимитер (-1.0 dB)" FontSize="12" FontWeight="SemiBold" Foreground="#ffffff"/>
                                <TextBlock Text="Защита от клиппинга и хрипа" FontSize="10.5" Foreground="#8b92a4"/>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Meme Mode -->
                    <Border Background="#2a1f24" BorderBrush="#4f2f39" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,3">
                                <TextBlock Text="Перегруз (Meme)" FontSize="12" FontWeight="Bold" Foreground="#f87171"/>
                                <CheckBox IsChecked="{Binding DestroyedMicMemeMode, Mode=TwoWay}" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="В Discord отключите Krisp (иначе звук заглушится)" 
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="#fbbf24" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Preferences -->
                    <Border Background="#16171d" BorderBrush="#2a2c37" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <CheckBox Content="Автозапуск с Windows" 
                                      IsChecked="{Binding AutoStartWithWindows, Mode=TwoWay}" 
                                      Margin="0,0,0,6" FontSize="11.5"/>
                            <CheckBox Content="Сворачивать в трей на [X]" 
                                      IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" 
                                      FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. CLEAN STATUS FOOTER -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="MicCompressor • Low-Latency Audio Engine" FontSize="11" Foreground="#555a6d" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusNotification}" FontSize="11" FontWeight="SemiBold" Foreground="#38bdf8" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#555a6d" VerticalAlignment="Center">
                <Run Text="Выход: "/>
                <Run Text="{Binding SelectedOutputDevice.Name, Mode=OneWay}" Foreground="#8b92a4"/>
            </TextBlock>
        </Grid>

        <!-- 5. MODAL: SAVE NEW PROFILE DIALOG OVERLAY -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Visibility="{Binding IsSaveProfileDialogVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="#99000000" Panel.ZIndex="300" Margin="-18">
            <Border Background="#1b1c22" BorderBrush="#353846" BorderThickness="1.5" CornerRadius="10"
                    Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Новый профиль" FontSize="15" FontWeight="Bold" Foreground="#ffffff" Margin="0,0,0,6"/>
                    <TextBlock Text="Введите название для сохранения текущих настроек компрессора, гейта и фильтров:" 
                               FontSize="12" Foreground="#8b92a4" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="16"/>

                    <TextBlock Text="НАЗВАНИЕ ПРОФИЛЯ" FontSize="10" FontWeight="Bold" Foreground="#8b92a4" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewProfileTextBox"
                             Text="{Binding ProfileNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="#252731" Foreground="#ffffff" BorderBrush="#3b82f6" BorderThickness="1.5"
                             Padding="10,8" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,20">
                        <TextBox.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Отмена" Command="{Binding CancelSaveProfileCommand}"
                                IsCancel="True"
                                Height="34" Background="#262833" Foreground="#c5cad6" FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#323543"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Content="Сохранить" Command="{Binding ConfirmSaveProfileCommand}"
                                IsDefault="True"
                                Height="34" Background="#2563eb" Foreground="#ffffff" FontSize="12" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1d4ed8"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
